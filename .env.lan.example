# Copy to .env.lan on the selected host. Never commit instance settings.
# This documentation-only private address is an example, not an assigned host.
LAN_BIND_IP=192.168.1.20
LAN_PORT=3030
LAN_ORIGIN=http://192.168.1.20:3030
# Generate each independently with: openssl rand -hex 32
# Use hex so the database password is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Supply both household owners' verified Apple emails out of band.
# HOUSEHOLD_EMAILS is the fallback when the normalized Apple list is empty.
# WARNING: An empty effective list leaves legacy /register OPEN.
# Apple sign-in then permits only already-bound subjects.
# A configured list CLOSES all password registration, including web sign-up.
# Set this on the deployment node; keep real addresses out of this public repo.
APPLE_HOUSEHOLD_EMAILS=
HOUSEHOLD_EMAILS=
