# Copy to .env.lan on the selected host. Never commit instance settings.
# This documentation-only private address is an example, not an assigned host.
LAN_BIND_IP=192.168.1.20
LAN_PORT=3030
LAN_ORIGIN=http://192.168.1.20:3030
# Generate each independently with: openssl rand -hex 32
# Use hex so the database password is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
